generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url = env("DATABASE_URL")
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  password           String
  firstName          String
  lastName           String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  otp                String?
  otpExpiresAt       DateTime? 
  photo              String         @default("https://img.freepik.com/premium-vector/user-profile-icon-flat-style-member-avatar-vector-illustration-isolated-background-human-permission-sign-business-concept_157943-15752.jpg")
  roles              UserRoles[]
  likes              Likes[] 
  ambulance          Ambulance[]
}

model UserRoles {
  id     String  @id @default(uuid())
  userId String
  role   Role
  user   User @relation(fields: [userId], references: [id])
}


model AccidentAlerts {
  id          String   @id @default(uuid())
  title       String?
  description String?
  location    String?
  latitude    Float
  longitude   Float
  phoneNumber String?
  email       String?
  status      Status   @default(NEW)
  assignTo    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assign                  Assign[]
}


enum Role {
  ADMIN
  DISPATCHER
  AMBTEAM
}

enum Status {
  NEW
  PENDING
  ATTENDED
  CLOSED
}


model Faq {
  id                      String           @id @default(uuid())
  question                String
  solution                String
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
}


model Blog {
  id                      String           @id @default(uuid())
  title                   String
  thumbnail               String
  teaser                  String
  description             String
  category                String
  likes                   Int           @default(0)
  views                   Int           @default(0)
  featured                Boolean
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt      
  likesModel              Likes[]            
}

model Likes {
  id                      String           @id  @default(uuid())
  userId                  String
  blogId                  String
  blog                    Blog @relation(fields: [blogId], references: [id])  
  user                    User @relation(fields: [userId], references: [id])  
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt    

  @@unique([blogId, userId])
}

model HealthFacility {
  id                      String           @id @default(uuid())
  name                    String
  location                String
  phoneNumber             String
  availableAmbulances     Int           @default(0)
  lat                     Float        @default(0.0)
  lng                     Float        @default(0.0)
  address                 String       @default("")
  category                String
  photo                   String        @default("https://res.cloudinary.com/dleiqpvue/image/upload/v1746332772/lifeline_alert/08eb2df0-f1e8-4672-87c1-93d588c53437.jpg")
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  ambulances              Ambulance[]
  assign                  Assign[]
}


model Ambulance {
  id                      String           @id @default(uuid())
  hospitalId              String
  driverId                String
  isAvailable             Boolean
  currentLocation         String
  description             String
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  hospital                HealthFacility   @relation(fields: [hospitalId], references: [id])
  user                    User             @relation(fields: [driverId], references: [id])
  assign                  Assign[]
}


model Assign {
  id                      String           @id @default(uuid())
  hospitalId              String?
  ambulanceId             String
  alertId                 String
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  hospital                HealthFacility?   @relation(fields: [hospitalId], references: [id])
  ambulance               Ambulance        @relation(fields: [ambulanceId], references: [id])
  alert                   AccidentAlerts   @relation(fields: [alertId], references: [id])
}